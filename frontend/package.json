{
  "name": "vigabss-frontend",
  "version": "0.1.0-alpha.19",
  "description": "VigaBSS 0.1.0-alpha.19 — Admin Panel (React + TypeScript + Vite)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run gen:api && tsc --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../docs/openapi.json -o src/api/schema.d.ts --empty-objects-unknown",
    "lint": "pnpm run gen:api && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "i18n:check": "node scripts/i18n-coverage.mjs",
    "i18n:baseline": "node scripts/i18n-coverage.mjs --write-baseline"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "@testing-library/dom": "^10.4.2",
    "@types/leaflet": "^1.9.22",
    "dompurify": "^3.4.17",
    "graphql-request": "^7.4.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.4.4",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
