# =============================================================================
# FireISP 5.0 — Production Environment Template
# =============================================================================
# Copy this file to .env.prod and fill in ALL required values before starting
# the stack:
#
#   cp .env.prod.example .env.prod
#   nano .env.prod
#   chmod 600 .env.prod
#
# Then bring the stack up:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ⚠  NEVER commit .env.prod — it is listed in .gitignore.
# =============================================================================

# ---- Application -------------------------------------------------------------
NODE_ENV=production
PORT=3000
APP_URL=https://your-domain.com
LOG_LEVEL=info

# 1 when system nginx terminates TLS and proxies to the app on 127.0.0.1:8080;
# 0 when the bundled Docker nginx owns ports 80/443. install.sh sets this.
FIREISP_HOST_NGINX=0

# ---- TLS / Let's Encrypt -----------------------------------------------------
# Required by the nginx service and init-letsencrypt.sh.
DOMAIN=your-domain.com
CERTBOT_EMAIL=admin@your-domain.com
# CF_API_TOKEN=

# ---- MySQL -------------------------------------------------------------------
# DB_HOST must match the docker-compose service name (db-primary).
DB_HOST=db-primary
DB_PORT=3306
DB_USER=fireisp
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_NAME=fireisp
# Root password for the MySQL container (docker-compose.prod.yml only).
DB_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# MySQL replication (docker-compose.prod.yml replica service).
MYSQL_REPL_USER=repl_user
MYSQL_REPL_PASSWORD=CHANGE_ME_strong_repl_password

# ---- Redis -------------------------------------------------------------------
# The :// password must match REDIS_PASSWORD below.
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_MAXMEMORY=256mb

# ---- Read Replica (optional) -------------------------------------------------
# When set, report and dashboard queries are routed to the replica.
# DB_REPLICA_HOST=db-replica
# DB_REPLICA_PORT=3306
# DB_REPLICA_USER=fireisp
# DB_REPLICA_PASSWORD=
# DB_REPLICA_POOL_SIZE=10

# ---- JWT / Sessions ----------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_char_random_hex_string
JWT_EXPIRES_IN=8h
# JWT_ACCESS_EXPIRES_IN=60m
# JWT_REFRESH_EXPIRES_IN=7d

# ---- Encryption (at-rest secrets) --------------------------------------------
# 64-char hex key for AES-256-GCM encryption of payment gateway credentials,
# PAC passwords, CSD keys, and webhook secrets stored in the database.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_64_char_random_hex_string

# ---- CORS -------------------------------------------------------------------
# Comma-separated allowlist of origins (optional — defaults to APP_URL).
# CORS_ORIGINS=https://app.your-domain.com,https://admin.your-domain.com

# ---- Admin IP Allowlist ------------------------------------------------------
# Required for admin-only endpoints in production. Until at least one valid
# trusted IPv4 address/CIDR is configured, those endpoints fail closed with 403.
ADMIN_IP_ALLOWLIST=
# Example: ADMIN_IP_ALLOWLIST=10.0.0.0/8,203.0.113.5

# ---- Connection Pool ---------------------------------------------------------
# DB_POOL_SIZE=20
# DB_QUEUE_LIMIT=0

# ---- SMTP / Email ------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-domain.com

# ---- Twilio (SMS & WhatsApp) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# ---- Generic SMS Provider ---------------------------------------------------
# SMS_PROVIDER=generic
# SMS_PROVIDER_URL=https://api.your-mx-gateway.com/v1/messages
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_FROM=

# ---- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Conekta -----------------------------------------------------------------
CONEKTA_API_KEY=
CONEKTA_WEBHOOK_KEY=

# ---- PAC Provider (CFDI stamping) --------------------------------------------
# Supported: finkok, sw_sapien
PAC_PROVIDER=finkok
PAC_USER=
PAC_PASSWORD=
PAC_URL=

# ---- RADIUS ------------------------------------------------------------------
RADIUS_SECRET=
RADIUS_HOST=127.0.0.1
RADIUS_COA_PORT=3799
# Embedded RADIUS server — FireISP itself answers Access-Request/Accounting
# (no external FreeRADIUS). See docs/radius-server.md. Defaults ON in prod compose.
RADIUS_SERVER_ENABLED=true
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
# Fallback shared secret for a matched NAS row with no per-NAS secret (optional):
RADIUS_SERVER_SECRET=
# Compatibility shared-secret endpoint only. Prefer a dedicated organization
# API token whose only scope is connection_logs:ingest.
RADIUS_ACCOUNTING_SECRET=
# Subscriber-session projection, lifecycle evidence, and UTC usage-delta rollup
# retention in calendar months (default operational policy: 24).
RADIUS_ACCOUNTING_RETENTION_MONTHS=24
# Tenant accounting collector requests/minute per API token (1-60000).
RADIUS_ACCOUNTING_REQUESTS_PER_MINUTE=6000
# Accepted Event-Timestamp future clock skew in seconds (0-3600).
RADIUS_ACCOUNTING_MAX_CLOCK_SKEW_SECONDS=300
# Optional syslog-shipper PPPoE event endpoint; use a separate strong secret.
# If empty, FireISP falls back to RADIUS_ACCOUNTING_SECRET.
PPPOE_EVENTS_SECRET=
# Newest RouterOS log entries considered per scheduled NAS poll (50-1000)
PPPOE_EVENT_POLL_LIMIT=500
# Minutes an open session (start/interim with no stop) keeps counting as LIVE
# for duplicate-session enforcement. A lost Acct-Stop leaves a ghost row; after
# this long without fresh accounting it stops counting (it is never kicked).
RADIUS_SESSION_LIVENESS_MINUTES=60

# ---- Privacy-minimal CGNAT attribution --------------------------------------
# Use a separate organization API token whose only scope is
# cgnat_attribution:ingest. An external collector submits authoritative NAT
# binding/allocation events only—not destination data or content. The product
# default and hard ordinary-retention maximum are 24 calendar months; scoped
# active case holds may preserve responsive evidence longer. Deploy only under
# an operator/counsel-approved purpose and schedule because the LMTR does not
# expressly enumerate CGNAT. The setting is installation-wide and must be
# approved for every enabled tenant; divergent schedules require separate
# deployments.
# This synchronous MySQL/HTTP sink is for assessed low-volume mappings or
# deterministic port blocks, not carrier-scale unsampled per-connection export.
CGNAT_ATTRIBUTION_RETENTION_MONTHS=24
CGNAT_ATTRIBUTION_INGEST_REQUESTS_PER_MINUTE=120 # per token; clamped 1-600
CGNAT_ATTRIBUTION_MAX_BATCH=500                  # events/request; hard max 1000
CGNAT_ATTRIBUTION_MAX_CLOCK_SKEW_SECONDS=300     # clamped 0-3600
CGNAT_ATTRIBUTION_SESSION_GRACE_SECONDS=900      # clamped 0-86400
CGNAT_ATTRIBUTION_STALE_MINUTES=15               # no heartbeat; quiet feed fails closed; clamped 1-1440
CGNAT_ATTRIBUTION_OPEN_BINDING_STALE_HOURS=24    # unreleased single-port readiness; clamped 1-8760
CGNAT_ATTRIBUTION_OPEN_PORT_BLOCK_STALE_DAYS=31  # unreleased port-block readiness; clamped 1-3650

# Who runs this INSTALL: comma-separated user IDs (users.id), e.g. "1".
# These accounts may change install-wide settings (ops_alert_email, map tiles)
# and use the update/deploy controls. Leave empty to use the users
# .is_install_operator flag, which migration 444 grants to the oldest active
# admin — on a self-hosted single-ISP box, the account that ran the installer.
# IDs, not emails: an email allowlist would be writable from inside the app.
INSTALL_OPERATOR_USER_IDS=

# ---- WireGuard (VPN hub) -----------------------------------------------------
# FireISP acts as the hub: NAS routers + technician/support/admin laptops dial in
# and FireISP routes between them to reach customer devices for monitoring and
# troubleshooting. ON BY DEFAULT in production — a normal redeploy activates it; the
# dial-in endpoint auto-derives from DOMAIN (above), and the app auto-generates +
# persists the two server keypairs to the wg_keys volume on first boot. Open UDP
# 51820/51821 in your cloud firewall. See docs/wireguard-setup.md.
# WG_SERVER_ENABLED=false     # uncomment to OPT OUT (the hub is on by default in prod)
# WG_ENDPOINT_HOST=           # optional — defaults to DOMAIN; set to override the public host NAS+clients dial
WG_LISTEN_PORT=51820          # wg-fireisp — NAS routers
WG_CLIENT_LISTEN_PORT=51821   # wg-clients — technician/support/admin laptops
WG_SERVER_SUBNET=10.255.0.0/16
WG_CLIENT_SUBNET=10.99.0.0/16
WG_KEY_DIR=/etc/wireguard     # docker-compose.prod.yml mounts the wg_keys volume here
# WG_SERVER_PUBLIC_KEY / WG_CLIENT_SERVER_PUBLIC_KEY are auto-generated + persisted —
# set them only to pin an externally-managed keypair.

# ---- SNMP Polling ------------------------------------------------------------
SNMP_COMMUNITY=public
SNMP_POLL_INTERVAL=300
# SNMP_POLL_CONCURRENCY=10

# ---- SNMP Trap Receiver ------------------------------------------------------
SNMP_TRAP_PORT=1620
# Application listener address for bare-node runs. Production Compose overrides
# the container listener to 0.0.0.0 behind its host publish boundary.
SNMP_TRAP_BIND_IP=127.0.0.1
# Docker host publish address. Use the trusted device-management IPv4 address
# only after restricting UDP in the firewall.
SNMP_TRAP_PUBLISH_IP=127.0.0.1
# Fixed-memory overload protection for the unauthenticated UDP listener.
SNMP_TRAP_MAX_IN_FLIGHT=16
SNMP_TRAP_RATE_PER_SECOND=50
SNMP_TRAP_RATE_BURST=100
# Separate installation and fixed-capacity per-source sustained budgets.
SNMP_TRAP_RATE_PER_MINUTE=600
SNMP_TRAP_RATE_MINUTE_BURST=120
SNMP_TRAP_SOURCE_RATE_PER_MINUTE=10
SNMP_TRAP_SOURCE_RATE_BURST=20
# Durable per-organization and installation-wide UTC-day storage/fan-out caps.
SNMP_TRAP_ORG_DAILY_ROW_LIMIT=10000
SNMP_TRAP_GLOBAL_DAILY_ROW_LIMIT=100000
SNMP_TRAP_ORG_DAILY_VARBIND_BYTES=16777216
SNMP_TRAP_GLOBAL_DAILY_VARBIND_BYTES=134217728
SNMP_TRAP_ORG_DAILY_DELIVERY_LIMIT=10000
SNMP_TRAP_GLOBAL_DAILY_DELIVERY_LIMIT=100000
# Redis-free immediate queue; overflow is recovered from durable SQL.
SNMP_TRAP_LOCAL_QUEUE_CAPACITY=100
# Graceful-shutdown deadline for committed/in-progress trap handling (ms).
SNMP_TRAP_DRAIN_TIMEOUT_MS=10000

# ---- FireRelay (multi-node clustering) ---------------------------------------
# Mode: standalone (default) | master | worker
FIRERELAY_MODE=standalone
# Required by GET /api/firerelay/health. Set the same 64-character random hex
# value on the master and every worker: openssl rand -hex 32
FIRERELAY_AUTH_TOKEN=CHANGE_ME_64_char_random_hex_string
# FIRERELAY_NODES=["https://node2.your-domain.com"]
# FIRERELAY_MASTER_URL=https://node1.your-domain.com
# FIRERELAY_NODE_ID=node2

# ---- Job Queue ---------------------------------------------------------------
# JOB_QUEUE_CONCURRENCY=5

# ---- Request Timeout ---------------------------------------------------------
# REQUEST_TIMEOUT_MS=30000

# ---- Rate Limiting -----------------------------------------------------------
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_API=200
# RATE_LIMIT_AUTH=20
# RATE_LIMIT_TENANT_WINDOW_MS=900000
# RATE_LIMIT_TENANT_API=500
# Synthetic trap-forwarding tests per operator and organization per window.
# RATE_LIMIT_TRAP_FORWARDING_TEST=10
# Real SMTP connection tests per operator and organization per rate-limit window.
# RATE_LIMIT_EMAIL_SETTINGS_TEST=5
# Per-IP, per-minute pre-authentication ceiling for the accounting/CGNAT
# collector endpoints; token and configured API-key limits also apply.
# Redis is required for shared counters across multiple app instances.
# RATE_LIMIT_COLLECTOR_INGRESS_PER_MINUTE=6000

# ---- Feature Flags -----------------------------------------------------------
# FEATURE_CFDI=true
# FEATURE_RADIUS=true
# FEATURE_2FA=true
# FEATURE_WEBHOOKS=true
# FEATURE_SNMP=true

# ---- Error Tracking (Sentry) ------------------------------------------------
# Optional. When enabled, FireISP suppresses request bodies, cookies,
# authorization headers, query strings and full URLs before export.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# ---- Database Backup ---------------------------------------------------------
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_PREFIX=db-backups/
# BACKUP_RETENTION=7

# ---- Data Retention ----------------------------------------------------------
# Empty, non-numeric, zero, or negative values fall back to the defaults shown.
# RETENTION_AUDIT_LOGS_DAYS=365
# RETENTION_ALERT_EVENTS_DAYS=90
# RETENTION_WEBHOOK_DELIVERIES_DAYS=90
# RETENTION_SNMP_TRAP_FORWARDING_DELIVERIES_DAYS=90
# RETENTION_SNMP_TRAPS_DAYS=180
# RETENTION_EMAIL_LOGS_DAYS=180
# RETENTION_SMS_LOGS_DAYS=180
# RETENTION_IDEMPOTENCY_KEYS_DAYS=7
# RETENTION_RADPOSTAUTH_DAYS=90
# RETENTION_PPPOE_EVENT_LOGS_DAYS=90
# RADIUS_ACCOUNTING_RETENTION_MONTHS and CGNAT_ATTRIBUTION_RETENTION_MONTHS are
# calendar-month policies declared above. Do not also set a corresponding legacy
# RETENTION_<TABLE>_DAYS override unless intentionally replacing it.

# ---- AI Reply Assistant — RAG (Retrieval-Augmented Generation) ---------------
# VECTOR_RETRIEVAL_ENABLED=false
# CHROMA_URL=http://chromadb:8000

# ---- Update notification -----------------------------------------------------
# The install operator gets a once-a-day banner (and a Settings -> Version tab)
# when a newer FireISP release exists. ON by default — a fresh install needs no
# configuration for this to work.
#
# This is the ONLY outbound request FireISP makes on its own behalf: an
# unauthenticated read of the newest commit on the public repo. No install data,
# no version, no identifiers are sent.
#
# Set to 0 on an air-gapped or isolated management network, where the request
# cannot succeed and you would rather it were never attempted:
# FIREISP_UPDATE_CHECK=0
