# =============================================================================
# FireISP 5.0 — Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your local environment.
# Never commit .env — it is listed in .gitignore.
# =============================================================================

# ---- Application ------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public URL the SPA is served from — used to build absolute links the browser
# will follow directly (SSO callbacks, checkout pay links, and the
# password-reset / email-verification links sent by email).
APP_URL=http://localhost:3000
# Reverse-proxy hops in front of the app (Express `trust proxy`). Defaults to
# 1 in production (one Nginx — docker-compose.prod, install.sh, host-nginx)
# and 0 otherwise. Set the real hop count for other topologies (e.g. 2 behind
# a load balancer + Nginx). Wrong value = per-IP rate limits either collapse
# into one shared bucket (too low) or become client-spoofable (too high).
# TRUST_PROXY=1

# ---- TLS / Let's Encrypt ----------------------------------------------------
# Required when running nginx/init-letsencrypt.sh or the certbot service.
# DOMAIN=isp.example.com
# CERTBOT_EMAIL=admin@example.com

# ---- MySQL ------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fireisp
# Root password used by docker-compose.prod.yml (separate from app user)
# DB_ROOT_PASSWORD=

# MySQL replication credentials (docker-compose.prod.yml only)
# MYSQL_REPL_USER=repl_user
# MYSQL_REPL_PASSWORD=

# ---- Encryption (at-rest secrets) -------------------------------------------
# 64-char hex key for AES-256-GCM encryption of payment gateway secrets, PAC
# passwords, CSD keys, and webhook secrets stored in the database.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When unset, values are stored / read as plaintext (development only).
# ENCRYPTION_KEY=

# ---- JWT / Sessions ---------------------------------------------------------
JWT_SECRET=change-me-in-production-this-default-jwt-secret-is-not-secure!!!
JWT_EXPIRES_IN=24h
# JWT_ALGORITHM=HS256  # HS256 (default) or RS256
# Refresh token rotation: short-lived access token + long-lived refresh token.
# JWT_ACCESS_EXPIRES_IN=60m   # Access token lifetime (default: 60 minutes)
# JWT_REFRESH_EXPIRES_IN=7d   # Refresh token lifetime (default: 7 days)

# ---- CORS -------------------------------------------------------------------
# Comma-separated allowlist of origins. If set, overrides the default APP_URL /
# localhost origins. Example: https://app.fireisp.com,https://admin.fireisp.com
# CORS_ORIGINS=

# ---- Admin IP Allowlist ------------------------------------------------------
# Restrict admin endpoints (users, roles, organizations, settings, audit-logs,
# scheduled-tasks, import, billing) to specific IPs or CIDR ranges.
# Comma-separated list of IPv4 addresses and/or CIDR blocks.
# When not set, all IPs are allowed (feature is opt-in).
# Example: ADMIN_IP_ALLOWLIST=10.0.0.0/8,203.0.113.5
# ADMIN_IP_ALLOWLIST=

# ---- Rate Limiting -----------------------------------------------------------
# All values are requests per window. Window default is 15 minutes (900000 ms).
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_API=1000
# RATE_LIMIT_AUTH=20
# POST /auth/password-reset/request AND POST /auth/verify-email/resend only
# (each gets its own independent limiter instance at this threshold) — stacks
# on top of RATE_LIMIT_AUTH above (which already covers both by prefix).
# Deliberately tighter: both send real email on every hit, making them
# mail-bombing / enumeration-timing targets, not just brute-force ones.
# RATE_LIMIT_PASSWORD_RESET=5
# Session-keepalive endpoints (/auth/me, /auth/refresh, /auth/logout,
# /auth/switch-organization) — separate bucket so heavy app usage can never
# rate-limit the session alive-keeping calls and force a re-login.
# RATE_LIMIT_SESSION=240
# RATE_LIMIT_PUBLIC=60
# RATE_LIMIT_UPLOAD=30
# RATE_LIMIT_EXPORT=20
# RATE_LIMIT_SSE=10
# RATE_LIMIT_WEBHOOK=100
# Synthetic trap-forwarding tests per operator and organization per window.
# Each request reaches a real email/HTTPS destination, so keep this modest.
# RATE_LIMIT_TRAP_FORWARDING_TEST=10
# Pre-authentication per-IP ceiling for machine collector routes, per minute.
# Successful collector calls also have route, token and optional configured
# API-key policy limits. Production should use Redis for cross-instance counts.
# RATE_LIMIT_COLLECTOR_INGRESS_PER_MINUTE=6000
# POST /bulk/email only — stacks on top of RATE_LIMIT_API above. A mass-send
# action reaching real client inboxes, same rationale as RATE_LIMIT_PASSWORD_RESET.
# RATE_LIMIT_BULK_EMAIL=10
# Per-organization rolling-24h RECIPIENT-count budget for POST /bulk/email
# (not a request count — one request can fan out to up to 1000 recipients).
# RATE_LIMIT_BULK_EMAIL_DAILY_RECIPIENTS=5000
# Per-tenant limits applied to all authenticated API requests (keyed by org ID)
# RATE_LIMIT_TENANT_WINDOW_MS=900000
# RATE_LIMIT_TENANT_API=2000

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=debug

# ---- SMTP / Email ------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@fireisp.local

# ---- Twilio (SMS & WhatsApp) ------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=

# ---- Generic SMS Provider (local MX gateway / Infobip / MessageBird / etc.) -
# Set SMS_PROVIDER=generic and provide the endpoint URL to use any HTTP-based
# SMS gateway instead of Twilio.  The provider receives a JSON POST body:
#   { "to": "+521234567890", "from": "<SMS_PROVIDER_FROM>", "body": "...", "channel": "sms" }
# and must respond with 2xx.  Set SMS_PROVIDER_API_KEY for Bearer auth.
# SMS_PROVIDER=generic
# SMS_PROVIDER_URL=https://api.your-mx-gateway.com/v1/messages
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_FROM=

# ---- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Required to receive Stripe webhooks. Without it the /payment-webhooks/stripe
# endpoint FAILS CLOSED (503) — it will not act on unsigned requests.
STRIPE_WEBHOOK_SECRET=

# ---- Conekta -----------------------------------------------------------------
CONEKTA_API_KEY=
# Required to receive Conekta webhooks. Without it /payment-webhooks/conekta
# FAILS CLOSED (503). See ALLOW_UNSIGNED_WEBHOOKS below.
CONEKTA_WEBHOOK_KEY=

# Escape hatch for LOCAL TESTING ONLY: when true, the payment-webhook endpoints
# will process unsigned payloads if no signing secret is configured. NEVER set
# this in production — it lets anyone forge "payment received" events.
# ALLOW_UNSIGNED_WEBHOOKS=false

# ---- PAC Provider (CFDI stamping) --------------------------------------------
# Supported: finkok, sw_sapien
PAC_PROVIDER=finkok
PAC_USER=
PAC_PASSWORD=
PAC_URL=

# ---- RADIUS ------------------------------------------------------------------
RADIUS_SECRET=
RADIUS_HOST=127.0.0.1
RADIUS_COA_PORT=3799
# Embedded RADIUS server — FireISP answers RADIUS auth/accounting itself
# (no external FreeRADIUS). See docs/radius-server.md. Off by default in dev.
RADIUS_SERVER_ENABLED=false
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SERVER_SECRET=
# Compatibility shared-secret FreeRADIUS endpoint (unset = disabled). Prefer a
# dedicated organization API token whose only scope is connection_logs:ingest.
RADIUS_ACCOUNTING_SECRET=
# Subscriber-session projection, lifecycle evidence, and UTC usage-delta rollup
# retention in calendar months (default operational policy: 24).
RADIUS_ACCOUNTING_RETENTION_MONTHS=24
# Tenant accounting collector requests/minute per API token (1-60000).
RADIUS_ACCOUNTING_REQUESTS_PER_MINUTE=6000
# Accepted Event-Timestamp future clock skew in seconds (0-3600).
RADIUS_ACCOUNTING_MAX_CLOCK_SKEW_SECONDS=300
# Optional syslog-shipper PPPoE event endpoint; falls back to accounting secret
PPPOE_EVENTS_SECRET=
# Newest RouterOS log entries considered per scheduled NAS poll (50-1000)
PPPOE_EVENT_POLL_LIMIT=500
# Minutes an open session (start/interim with no stop) keeps counting as LIVE
# for duplicate-session enforcement. A lost Acct-Stop leaves a ghost row; after
# this long without fresh accounting it stops counting (it is never kicked).
RADIUS_SESSION_LIVENESS_MINUTES=60

# ---- Privacy-minimal CGNAT attribution --------------------------------------
# Requires a separate organization API token whose only scope is
# cgnat_attribution:ingest. An external collector must submit authoritative NAT
# binding/allocation events; FireISP is not a RouterOS/NetFlow/IPFIX listener.
# Do not submit destination addresses/ports, URLs, domains, DNS, or content.
# This synchronous MySQL/HTTP sink is for assessed low-volume bindings or
# deterministic port blocks, not carrier-scale unsampled per-connection export.
# Retention is one installation-wide operator/counsel-approved calendar-month
# policy. It must suit every enabled tenant; divergent schedules require
# separate deployments. Default and hard ordinary-retention maximum: 24;
# scoped active case holds may extend preservation. LMTR does not expressly
# enumerate CGNAT.
CGNAT_ATTRIBUTION_RETENTION_MONTHS=24
# Safety ceiling for binding-ingest requests/minute per token (1-600), not a capacity promise.
CGNAT_ATTRIBUTION_INGEST_REQUESTS_PER_MINUTE=120
# Binding events accepted per request (default 500, hard maximum 1000).
CGNAT_ATTRIBUTION_MAX_BATCH=500
# Accepted binding timestamp future skew in seconds (0-3600).
CGNAT_ATTRIBUTION_MAX_CLOCK_SKEW_SECONDS=300
# Correlation grace around a subscriber RADIUS session, in seconds (0-86400).
CGNAT_ATTRIBUTION_SESSION_GRACE_SECONDS=900
# Minutes since the last authoritative allocate/release receipt before the feed
# and open mappings fail closed as stale (1-1440). V1 has no heartbeat; a quiet
# exporter cannot claim continuous coverage merely because a binding is open.
CGNAT_ATTRIBUTION_STALE_MINUTES=15
# Hours before an unreleased single-port mapping makes readiness fail closed
# (1-8760). Reconcile against the authoritative translator; never invent release.
CGNAT_ATTRIBUTION_OPEN_BINDING_STALE_HOURS=24
# Days before an unreleased deterministic port-block allocation makes readiness
# fail closed (1-3650). Use the operator-approved maximum allocation lifetime.
CGNAT_ATTRIBUTION_OPEN_PORT_BLOCK_STALE_DAYS=31

# Who runs this INSTALL: comma-separated user IDs (users.id), e.g. "1".
# These accounts may change install-wide settings (ops_alert_email, map tiles)
# and use the update/deploy controls. Leave empty to use the users
# .is_install_operator flag, which migration 444 grants to the oldest active
# admin — on a self-hosted single-ISP box, the account that ran the installer.
# IDs, not emails: an email allowlist would be writable from inside the app.
INSTALL_OPERATOR_USER_IDS=

# ---- WireGuard (VPN hub) -----------------------------------------------------
# FireISP acts as the hub: NAS routers + technician/support/admin laptops dial in
# and FireISP routes between them to reach customer devices. Off by default — when
# enabled the app auto-generates + persists the two server keypairs and brings up
# the interfaces on boot. Linux host with CAP_NET_ADMIN only (see docs/wireguard-setup.md).
WG_SERVER_ENABLED=false
# WG_ENDPOINT_HOST=          # optional — defaults to DOMAIN; the public host/IP NAS + clients dial
# WG_LISTEN_PORT=51820       # wg-fireisp — NAS routers
# WG_CLIENT_LISTEN_PORT=51821 # wg-clients — user laptops
# WG_SERVER_SUBNET=10.255.0.0/16
# WG_CLIENT_SUBNET=10.99.0.0/16
# WG_KEY_DIR=/etc/wireguard  # where server keypairs are generated/persisted (mount a volume here)
# WG_SERVER_PUBLIC_KEY / WG_CLIENT_SERVER_PUBLIC_KEY are auto-generated on first boot —
# set them only to pin an externally-managed keypair.

# ---- VoIP/RTC address-list auto-updater (voipRangesService) ------------------
# Refreshes the fireisp-voip address-list on managed NAS from provider IP-range
# endpoints so the §VoIP realtime-priority mangle keeps matching current RTC media.
# Disabled by default; enable once real-time priority is seeded on your NAS. The
# scheduled task (refresh_voip_ranges, migration 373) is also seeded disabled.
# VOIP_RANGES_ENABLED=false
# Comma-separated source URLs (plain CIDR-per-line OR Google-style JSON). Default =
# Zoom's published RTC ranges (a real-time-only service, safe to prioritise).
# VOIP_RANGES_SOURCE_URLS=https://assets.zoom.us/docs/ipranges/Zoom.txt
# VOIP_RANGES_MAX_ENTRIES=4000
# VOIP_RANGES_FETCH_TIMEOUT_MS=10000

# ---- SNMP Polling ------------------------------------------------------------
SNMP_COMMUNITY=public
SNMP_POLL_INTERVAL=300
# SNMP_POLL_CONCURRENCY=10

# ---- SNMP Trap Receiver ------------------------------------------------------
# UDP port the trap receiver listens on.  Use 162 only when running as root.
# For non-root deployments redirect with iptables:
#   iptables -t nat -A PREROUTING -p udp --dport 162 -j REDIRECT --to-port 1620
SNMP_TRAP_PORT=1620
# Application listener address. Bare-node runs default safely to loopback;
# Compose overrides the container listener to 0.0.0.0 behind its host publish.
SNMP_TRAP_BIND_IP=127.0.0.1
# Docker host publish address. Set this to the trusted device-management IPv4
# address only after restricting UDP in the host/network firewall.
SNMP_TRAP_PUBLISH_IP=127.0.0.1
# Fixed-memory overload protection for the unauthenticated UDP listener.
# Invalid/out-of-range values fall back to these safe defaults.
SNMP_TRAP_MAX_IN_FLIGHT=16
SNMP_TRAP_RATE_PER_SECOND=50
SNMP_TRAP_RATE_BURST=100
# Separate installation and fixed-capacity per-source sustained budgets.
SNMP_TRAP_RATE_PER_MINUTE=600
SNMP_TRAP_RATE_MINUTE_BURST=120
SNMP_TRAP_SOURCE_RATE_PER_MINUTE=10
SNMP_TRAP_SOURCE_RATE_BURST=20
# Durable UTC-day budgets. Organization ceilings prevent one noisy tenant from
# consuming the higher installation safety ceiling. Byte exhaustion stores
# metadata only; row/delivery exhaustion stores no new forwarding work.
SNMP_TRAP_ORG_DAILY_ROW_LIMIT=10000
SNMP_TRAP_GLOBAL_DAILY_ROW_LIMIT=100000
SNMP_TRAP_ORG_DAILY_VARBIND_BYTES=16777216
SNMP_TRAP_GLOBAL_DAILY_VARBIND_BYTES=134217728
SNMP_TRAP_ORG_DAILY_DELIVERY_LIMIT=10000
SNMP_TRAP_GLOBAL_DAILY_DELIVERY_LIMIT=100000
# Redis-free fallback accepts at most this many immediate in-process trap jobs;
# overflow remains durable in SQL for the scheduled retry sweep.
SNMP_TRAP_LOCAL_QUEUE_CAPACITY=100
# Graceful-shutdown deadline for committed/in-progress trap handling (ms).
SNMP_TRAP_DRAIN_TIMEOUT_MS=10000

# ---- MikroTik hAP Lab Integration Tests (Roadmap 3.1) -----------------------
# Set MIKROTIK_HAP_HOST to enable real-hardware integration tests:
#   MIKROTIK_HAP_HOST=<ip>  npx jest tests/mikrotikHapIntegration.test.js
# MIKROTIK_HAP_HOST=
# MIKROTIK_HAP_PORT=8728
# MIKROTIK_HAP_USER=admin
# MIKROTIK_HAP_PASS=

# ---- FireRelay (multi-node clustering) ---------------------------------------
# Mode: standalone (default) | master | worker
FIRERELAY_MODE=standalone
# Master-only: JSON array of worker node URLs
# FIRERELAY_NODES=["https://node2.fireisp.com"]
# FIRERELAY_HEALTH_INTERVAL=30000
# FIRERELAY_REQUEST_TIMEOUT=5000
# FIRERELAY_MAX_RETRIES=3
# Worker-only:
# FIRERELAY_MASTER_URL=https://node1.fireisp.com
# FIRERELAY_NODE_ID=node2
# FIRERELAY_AUTO_INCREMENT_OFFSET=10000001
# Capacity thresholds (all nodes):
# FIRERELAY_MAX_CLIENTS=10000
# FIRERELAY_MAX_DEVICES=3000

# ---- Connection Pool ---------------------------------------------------------
# DB_POOL_SIZE=20
# DB_QUEUE_LIMIT=0
# DB_KEEP_ALIVE_MS=30000

# ---- Read Replica (optional) -------------------------------------------------
# When set, report and dashboard queries are routed to the replica pool.
# Omit (or leave blank) to send all reads to the primary database.
# DB_REPLICA_HOST=
# DB_REPLICA_PORT=3306
# DB_REPLICA_USER=
# DB_REPLICA_PASSWORD=
# DB_REPLICA_POOL_SIZE=10

# ---- Redis / Caching --------------------------------------------------------
# Set REDIS_URL to enable Redis-backed caching and job queues.
# Requires: npm install ioredis (for cache) and/or npm install bullmq (for jobs)
# REDIS_URL=redis://localhost:6379
# Password required in production (docker-compose.prod.yml injects this automatically).
# REDIS_PASSWORD=
# REDIS_MAXMEMORY=256mb

# ---- Job Queue ---------------------------------------------------------------
# JOB_QUEUE_CONCURRENCY=5

# ---- Request Timeout ---------------------------------------------------------
# Maximum request duration in milliseconds (default: 30000 = 30s, 0 = disabled)
# REQUEST_TIMEOUT_MS=30000

# ---- Feature Flags -----------------------------------------------------------
# Enable/disable optional subsystems at runtime (all enabled by default)
# FEATURE_CFDI=true
# FEATURE_RADIUS=true
# FEATURE_2FA=true
# FEATURE_WEBHOOKS=true
# FEATURE_SNMP=true

# ---- Error Tracking (Sentry) -----------------------------------------------
# Set SENTRY_DSN to enable automatic error capturing and reporting to Sentry.
# When not set the integration is disabled and no data is sent (opt-in).
# Obtain your DSN at https://sentry.io/ → Project Settings → Client Keys.
# FireISP suppresses request bodies, cookies, authorization headers, query
# strings and full URLs, then applies a second fail-closed event scrubber.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production   # defaults to NODE_ENV
# SENTRY_RELEASE=                 # e.g. git tag, CI commit SHA
# SENTRY_TRACES_SAMPLE_RATE=0     # 0–1; set >0 to enable performance tracing

# ---- Data Retention ----------------------------------------------------------
# Override default retention periods (in days). Defaults shown below.
# Empty, non-numeric, zero, or negative values fall back to these safe defaults.
# RETENTION_AUDIT_LOGS_DAYS=365
# RETENTION_ALERT_EVENTS_DAYS=90
# RETENTION_WEBHOOK_DELIVERIES_DAYS=90
# RETENTION_SNMP_TRAP_FORWARDING_DELIVERIES_DAYS=90
# RETENTION_SNMP_TRAPS_DAYS=180
# RETENTION_EMAIL_LOGS_DAYS=180
# RETENTION_SMS_LOGS_DAYS=180
# RETENTION_IDEMPOTENCY_KEYS_DAYS=7
# RETENTION_RADPOSTAUTH_DAYS=90
# RETENTION_PPPOE_EVENT_LOGS_DAYS=90
# RADIUS_ACCOUNTING_RETENTION_MONTHS and CGNAT_ATTRIBUTION_RETENTION_MONTHS are
# calendar-month policies declared in the RADIUS/CGNAT section above. The legacy
# RETENTION_CONNECTION_LOGS_DAYS, RETENTION_RADIUS_ACCOUNTING_EVENTS_DAYS,
# and RETENTION_RADIUS_ACCOUNTING_USAGE_DAILY_DAYS overrides remain supported,
# but should not be combined with their corresponding month variable.

# ---- Database Backup ---------------------------------------------------------
# Cloud storage destination for the daily database backup cron job.
# Supports any S3-compatible API: AWS S3, Google Cloud Storage (interop HMAC
# keys, endpoint https://storage.googleapis.com), Backblaze B2, Cloudflare R2,
# or a self-hosted MinIO server.
# When not set, backups are saved locally in storage/backups/ only.
#
# NOTE (migration 404): the destination can also be configured from the UI at
# Admin -> Backups. An ENABLED UI configuration takes precedence over these
# env vars; when it is absent or disabled, these env vars remain the fallback.
#
# AWS S3 example:
#   BACKUP_S3_BUCKET=my-isp-backups
#   BACKUP_S3_REGION=us-east-1
#   BACKUP_S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
#   BACKUP_S3_SECRET_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
#
# Backblaze B2 example (S3-compatible endpoint):
#   BACKUP_S3_BUCKET=my-isp-backups
#   BACKUP_S3_REGION=us-west-002
#   BACKUP_S3_ACCESS_KEY=<B2 Application Key ID>
#   BACKUP_S3_SECRET_KEY=<B2 Application Key>
#   BACKUP_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
#
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_PREFIX=db-backups/
# BACKUP_RETENTION=7

# ---- AI Reply Assistant — RAG (Retrieval-Augmented Generation) ----------------
# Set to 'true' to enable vector retrieval. Requires the chromadb sidecar:
#   docker compose --profile rag up -d
# VECTOR_RETRIEVAL_ENABLED=false
# CHROMA_URL=http://localhost:8000
