# Dependencies
node_modules/

# graphify knowledge-graph output (local dev tool, not a repo artifact)
graphify-out/

# npm lockfiles superseded by pnpm-lock.yaml
package-lock.json

# Environment
.env
.env.prod
.env.local
# redeploy.sh writes .env.prod.bak-<timestamp> before it edits the file. Those
# are byte-identical copies of the secrets (DB_ROOT_PASSWORD, JWT_SECRET,
# ENCRYPTION_KEY, ADMIN_PASSWORD), living in the git working tree on the
# production host. The literal `.env.prod` above does NOT match them.
.env.prod.bak-*
.env*.bak-*

# TLS credentials (never commit secrets)
nginx/certs/
nginx/letsencrypt/
# Transient backup created by nginx/init-letsencrypt.sh during TLS bootstrap.
# A trap removes it on success; this entry guarantees it never reaches git
# even if the script is interrupted at the wrong moment.
nginx/.nginx.conf.bootstrap-backup

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build artifacts
dist/

# Runtime file uploads. Everything now lands under storage/ (STORAGE_ROOT in
# src/middleware/upload.js) — the only directory any deployment mounts. Keep the
# scaffolded subdirectories, ignore whatever gets uploaded into them.
storage/**/*
# Re-include the DIRECTORIES themselves. Without this git treats each excluded
# subdirectory as pruned, never descends into it, and the .gitkeep negation
# below can never match — new subdirectories silently lose their scaffolding.
!storage/**/
!storage/**/.gitkeep

# Legacy: ticket and work-order attachments were written here before they were
# moved under storage/. Still ignored so an old working copy stays clean.
uploads/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
