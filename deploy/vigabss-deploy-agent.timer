[Unit]
Description=Poll for VigaBSS deploy requests made from the web GUI

[Timer]
# First check shortly after boot, then every 30s. The interval is the worst-case
# delay between pressing the button and the deploy starting; 30s keeps that
# comfortably under a minute while costing one trivial query per poll.
OnBootSec=60
OnUnitActiveSec=30s
AccuracySec=5s
# Type=oneshot prevents overlap within this unit name. deploy-agent.sh also
# holds a shared host lock, which covers the brief migration window where the
# legacy fireisp timer and this canonical timer can both exist.
Unit=vigabss-deploy-agent.service

[Install]
WantedBy=timers.target
